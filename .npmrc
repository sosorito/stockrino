audit=false
fund=false
# Every native dependency in this project (better-sqlite3, sharp) ships prebuilt
# binaries for all major platforms directly inside its published npm package, so
# no compiler toolchain or postinstall network access is required. Skipping
# lifecycle scripts also sidesteps a known npm bug where a lockfile-driven
# `npm install` ignores better-sqlite3's `gypfile: false` and attempts an
# unnecessary (and unsupported) source rebuild.
ignore-scripts=true
