# ----------------------------------------------------------------------------
# Database (PostgreSQL) - REQUIRED
# ----------------------------------------------------------------------------
# A Postgres connection string. On Vercel, add a Postgres store from the
# Storage tab (Neon) and this is injected automatically as POSTGRES_URL /
# DATABASE_URL - no need to set it by hand there.
# For local dev, paste your Neon/Supabase/Postgres pooled connection string:
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ----------------------------------------------------------------------------
# Image uploads (Vercel Blob) - REQUIRED for the admin media library
# ----------------------------------------------------------------------------
# On Vercel, add a Blob store from the Storage tab and this is injected
# automatically. For local dev, copy the token from your Vercel Blob store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
# Long random string used to sign admin session tokens. MUST be changed for
# production. Generate one with: openssl rand -base64 32
AUTH_SECRET=change-this-to-a-long-random-string-in-production

# The public URL of your deployed site (used for canonical URLs, sitemap, OG).
SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Initial admin account - only used the first time `npm run db:seed` runs
# ----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@stockrino.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Stockrino@123
